/* ==================== DASHBOARD LAYOUT ==================== */

.dashboard-body {
    margin: 0;
    padding: 0;
    display: flex;
    min-height: 100vh;
    background: #0a0e1a;
    overflow-x: hidden;
}

/* ==================== SIDEBAR ==================== */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 260px;
    height: 100vh;
    background: rgba(23, 26, 34, 0.95);
    backdrop-filter: blur(10px);
    border-right: 1px solid rgba(0, 212, 255, 0.1);
    display: flex;
    flex-direction: column;
    z-index: 1000;
}

.sidebar-header {
    padding: var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.sidebar-header .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.sidebar-header .logo-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.3rem;
    font-weight: 900;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 2px;
}

/* ==================== SIDEBAR NAVIGATION ==================== */

.sidebar-nav {
    flex: 1;
    padding: var(--spacing-md) 0;
    overflow-y: auto;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 14px var(--spacing-md);
    color: #8892b0;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition: all var(--transition-fast);
    border-left: 3px solid transparent;
    cursor: pointer;
}

.nav-item:hover {
    background: rgba(0, 212, 255, 0.05);
    color: var(--primary);
    border-left-color: var(--primary);
}

.nav-item.active {
    background: rgba(0, 212, 255, 0.1);
    color: var(--light);
    border-left-color: var(--primary);
}

.nav-icon {
    font-size: 1.3rem;
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.nav-label {
    flex: 1;
}

/* ==================== SIDEBAR FOOTER ==================== */

.sidebar-footer {
    padding: var(--spacing-md);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
}

.user-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
}

.user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gradient-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--light);
}

.user-details {
    flex: 1;
    min-width: 0;
}

.user-email {
    font-size: 0.85rem;
    color: var(--gray-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.user-balance {
    font-size: 0.9rem;
    color: var(--primary);
    font-weight: 600;
}

/* Sidebar Language Switcher */
.sidebar-language-switcher {
    display: flex;
    gap: 0.5rem;
    margin-top: var(--spacing-xs);
}

.sidebar-lang-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--gray-light);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.sidebar-lang-btn:hover {
    background: rgba(0, 212, 255, 0.1);
    border-color: rgba(0, 212, 255, 0.3);
    color: var(--primary);
}

.sidebar-lang-btn.active {
    background: rgba(0, 212, 255, 0.2);
    border-color: var(--primary);
    color: var(--primary);
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
}

.sidebar-lang-btn .flag-icon {
    font-size: 1.1rem;
    line-height: 1;
}

.sidebar-lang-btn .lang-label {
    font-weight: 500;
}

/* Sidebar Logout Button */
.sidebar-logout-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-sm);
    color: #ef4444;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    margin-top: var(--spacing-xs);
}

.sidebar-logout-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: #ef4444;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
}

.sidebar-logout-btn i {
    font-size: 1.2rem;
}

.sidebar-logout-btn .logout-label {
    font-weight: 600;
}

/* ==================== MAIN CONTENT ==================== */

.main-content {
    margin-left: 260px;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* ==================== TOPBAR ==================== */

.topbar {
    height: 70px;
    background: rgba(23, 26, 34, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0, 212, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--spacing-lg);
    position: sticky;
    top: 0;
    z-index: 100;
}

.topbar-left {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
}

.page-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--light);
    margin: 0;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.topbar-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--gray-light);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    position: relative;
}

.topbar-btn:hover {
    background: rgba(0, 212, 255, 0.1);
    border-color: var(--primary);
    color: var(--primary);
}

.topbar-btn .icon {
    font-size: 1.2rem;
}

.topbar-btn .badge {
    position: absolute;
    top: -5px;
    right: -5px;
    background: var(--accent);
    color: var(--light);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    min-width: 18px;
    text-align: center;
}

/* ==================== CONTENT AREA ==================== */

.content-area {
    flex: 1;
    padding: var(--spacing-lg);
    overflow-y: auto;
}

.page-content {
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ==================== STATS GRID ==================== */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
}

.stat-card {
    background: rgba(23, 26, 34, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: var(--radius-md);
    padding: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: all var(--transition-normal);
    min-width: 0;
}

.stat-card:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 20px rgba(0, 212, 255, 0.2);
    transform: translateY(-2px);
}

.stat-icon {
    font-size: 2.25rem;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 212, 255, 0.1);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
}

.stat-info {
    flex: 1;
    min-width: 0;
    overflow: hidden;
}

.stat-label {
    font-size: 0.85rem;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.3rem;
}

.stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--light);
    font-family: 'Orbitron', sans-serif;
    transition: font-size 0.3s ease;
    display: block;
    width: 100%;
}

/* ==================== SECTIONS ==================== */

.section {
    margin-bottom: var(--spacing-lg);
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid rgba(0, 212, 255, 0.2);
    flex-wrap: wrap;
    gap: var(--spacing-sm);
}

.section-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--light);
    margin: 0;
}

.section-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.last-update {
    font-size: 0.85rem;
    color: var(--gray);
    font-style: italic;
}

.btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
}

.btn-icon {
    margin-right: 0.5rem;
}

/* ==================== ACTIONS GRID ==================== */

.actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-md);
}

.action-btn {
    background: rgba(23, 26, 34, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-sm);
    cursor: pointer;
    transition: all var(--transition-normal);
    color: var(--gray-light);
}

.action-btn:hover {
    border-color: var(--primary);
    background: rgba(0, 212, 255, 0.05);
    transform: translateY(-3px);
    box-shadow: 0 4px 15px rgba(0, 212, 255, 0.2);
}

.action-icon {
    font-size: 2.5rem;
}

.action-label {
    font-size: 1rem;
    font-weight: 600;
}

/* ==================== ACTIVITY LIST ==================== */

.activity-list {
    background: rgba(23, 26, 34, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.activity-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.activity-item:last-child {
    border-bottom: none;
}

.activity-icon {
    font-size: 2rem;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 212, 255, 0.1);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
}

.activity-content {
    flex: 1;
}

.activity-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--light);
    margin-bottom: 0.25rem;
}

.activity-desc {
    font-size: 0.9rem;
    color: var(--gray);
    margin-bottom: 0.5rem;
}

.activity-time {
    font-size: 0.8rem;
    color: var(--gray);
}

/* ==================== PLACEHOLDER ==================== */

.placeholder-text {
    text-align: center;
    color: var(--gray);
    font-size: 1.1rem;
    padding: var(--spacing-xl);
}

/* ==================== SETTINGS PAGE ==================== */

.settings-card {
    background: rgba(23, 26, 34, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

/* ==================== EARNINGS CHART ==================== */

.earnings-card {
    background: rgba(23, 26, 34, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
}

.earnings-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.earnings-stat-item {
    text-align: center;
}

.earnings-stat-label {
    font-size: 0.85rem;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
}

.earnings-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    font-family: 'Orbitron', sans-serif;
}

.chart-container {
    position: relative;
    height: 300px;
    margin-top: var(--spacing-md);
}

.chart-container canvas {
    max-height: 300px;
}

.settings-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.settings-row:last-child {
    border-bottom: none;
}

.settings-label {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--gray-light);
    font-weight: 500;
}

.label-icon {
    font-size: 1.2rem;
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.label-text {
    font-size: 0.95rem;
}

.settings-value {
    color: var(--light);
    font-weight: 600;
}

/* ==================== SETTINGS FORM ==================== */

.form-group-settings {
    margin-bottom: var(--spacing-md);
}

.form-group-settings label {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--gray-light);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: var(--spacing-xs);
}

.form-group-settings input {
    width: 100%;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--light);
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem;
    transition: all var(--transition-normal);
}

.form-group-settings input:focus {
    outline: none;
    border-color: var(--primary);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
}

.form-hint-settings {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--gray);
}

.form-actions {
    display: flex;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
}

.btn-icon {
    margin-right: 0.5rem;
}

/* ==================== RESPONSIVE ==================== */

@media (max-width: 1024px) {
    .sidebar {
        width: 220px;
    }
    
    .main-content {
        margin-left: 220px;
    }
}

@media (max-width: 768px) {
    .sidebar {
        transform: translateX(-100%);
        transition: transform var(--transition-normal);
    }
    
    .sidebar.mobile-open {
        transform: translateX(0);
    }
    
    .main-content {
        margin-left: 0;
    }
    
    .topbar {
        padding: 0 var(--spacing-md);
    }
    
    .page-title {
        font-size: 1.3rem;
    }
    
    .topbar-btn .label {
        display: none;
    }
    
    .content-area {
        padding: var(--spacing-md);
    }
    
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .actions-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .section-header {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .section-actions {
        width: 100%;
        flex-direction: column;
    }
    
    .last-update {
        order: 2;
    }
    
    .btn-sm {
        width: 100%;
        order: 1;
    }
}

@media (max-width: 480px) {
    .actions-grid {
        grid-template-columns: 1fr;
    }
}

/* ==================== SETTINGS INFO ==================== */
.settings-info {
    margin-bottom: 1.5rem;
}

.info-text {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    background: rgba(0, 212, 255, 0.05);
    border: 1px solid rgba(0, 212, 255, 0.2);
    border-radius: 8px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
}

.info-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
}

.info-text a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
}

.info-text a:hover {
    text-decoration: underline;
}

.settings-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 1.5rem 0;
}

/* ==================== BUTTON VARIANTS ==================== */
.btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
}

.btn-success {
    background: linear-gradient(135deg, #00d084 0%, #00a86b 100%);
    color: white;
}

.btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 208, 132, 0.3);
}

.btn-success:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

/* ==================== FORM ACTIONS ==================== */
.form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
}

.form-actions .btn {
    flex: 1;
}

@media (max-width: 768px) {
    .form-actions {
        flex-direction: column;
    }
    
    .form-actions .btn {
        width: 100%;
    }
}

/* ==================== CHART INFO NOTE ==================== */
.chart-info-note {
    padding: 0.875rem 1rem;
    margin-bottom: 1.25rem;
    background: rgba(255, 193, 7, 0.1);
    border-left: 3px solid #ffc107;
    border-radius: 4px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-secondary);
}

.chart-info-note p {
    margin: 0;
}

@media (max-width: 768px) {
    .chart-info-note {
        font-size: 0.8rem;
        padding: 0.75rem;
    }
}


/* ==================== ACCOUNTS PAGE ==================== */

.accounts-table-container {
    background: rgba(23, 26, 34, 0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: var(--radius-md);
    overflow: hidden;
}

.accounts-table {
    width: 100%;
    border-collapse: collapse;
}

.accounts-table thead {
    background: rgba(0, 212, 255, 0.1);
}

.accounts-table th {
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    border-bottom: 2px solid rgba(0, 212, 255, 0.3);
}

.accounts-table td {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--gray-light);
}

.accounts-table tbody tr {
    transition: all var(--transition-fast);
}

.accounts-table tbody tr:hover {
    background: rgba(0, 212, 255, 0.05);
}

.accounts-table tbody tr:last-child td {
    border-bottom: none;
}

.username-cell {
    font-weight: 600;
    color: var(--light);
}

.secret-cell {
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
}

.secret-hidden,
.secret-visible {
    display: inline-block;
    min-width: 100px;
}

.actions-cell {
    display: flex;
    gap: 0.5rem;
}

.btn-icon-small {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--gray-light);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-size: 1rem;
}

.btn-icon-small:hover {
    background: rgba(0, 212, 255, 0.1);
    border-color: var(--primary);
    color: var(--primary);
}

.btn-icon-small.btn-edit:hover {
    background: rgba(0, 212, 255, 0.1);
    border-color: var(--primary);
    color: var(--primary);
}

.btn-icon-small.btn-delete:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: #ef4444;
    color: #ef4444;
}

.loading-row td {
    text-align: center;
    padding: 3rem;
    color: var(--gray);
}

.text-center {
    text-align: center;
}

/* Empty State */
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    color: var(--gray);
}

.empty-state i {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
}

.empty-state p {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
}

/* ==================== MODERN FULL-WIDTH MODAL SYSTEM ==================== */

/* Override general modal styles for compact modal */
.modal-content.modal-compact {
    max-width: 480px;
    width: 96%;
    margin: 2vh auto;
    max-height: 96vh;
    overflow: hidden;
    position: relative;
    padding: 0 !important; /* Override general modal padding */
    background: linear-gradient(145deg, rgba(15, 20, 30, 0.98), rgba(25, 30, 40, 0.95));
    border: 1px solid rgba(0, 212, 255, 0.2);
    border-radius: 16px;
    box-shadow: 
        0 20px 60px rgba(0, 0, 0, 0.4),
        0 0 0 1px rgba(0, 212, 255, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
}

/* Header - minimal padding with important */
.modal-compact .modal-header {
    padding: 1rem 1.5rem 0.5rem 1.5rem !important; /* Force override */
    border-bottom: 1px solid rgba(0, 212, 255, 0.15);
    position: relative;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.05), transparent);
}

.modal-compact .modal-title {
    font-size: 1.6rem;
    font-weight: 700;
    text-align: center;
    margin: 0;
    padding-right: 0; /* Remove padding since no close button */
    background: linear-gradient(135deg, var(--primary), #00b8e6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.5px;
}

.modal-compact .modal-close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    width: 36px;
    height: 36px;
    font-size: 1.3rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: var(--gray-light);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-compact .modal-close:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #ef4444;
    transform: scale(1.05);
}

/* Body - minimal padding with important */
.modal-compact .modal-body {
    padding: 0.5rem 0 1.5rem 0 !important; /* Force override */
    max-height: calc(96vh - 140px);
    overflow-y: auto;
    position: relative;
}

/* Form - full width, modern spacing */
.compact-form {
    position: relative;
    min-height: 420px;
    padding-top: 0; /* Remove top padding to eliminate space after header */
}

/* Form rows - minimal spacing with important */
.compact-form .form-row {
    margin: 0 0 0.8rem 0 !important; /* Force override */
    padding: 0 1.5rem;
}

.compact-form .form-row:last-of-type {
    margin-bottom: 0;
}

/* Labels - minimal spacing with important */
.compact-form label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--light);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 0.3rem !important; /* Force override */
    width: 100%;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.85rem;
}

.compact-form label i {
    font-size: 1.2rem;
    color: var(--primary);
    background: rgba(0, 212, 255, 0.1);
    padding: 0.3rem;
    border-radius: 6px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Inputs - modern glass effect */
.compact-form input {
    width: 100%;
    padding: 1rem 1.2rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: var(--light);
    font-size: 0.95rem;
    transition: all 0.3s ease;
    box-sizing: border-box;
    margin: 0;
    backdrop-filter: blur(10px);
}

.compact-form input:focus {
    outline: none;
    border-color: var(--primary);
    background: rgba(0, 212, 255, 0.05);
    box-shadow: 
        0 0 0 3px rgba(0, 212, 255, 0.15),
        0 4px 20px rgba(0, 212, 255, 0.1);
    transform: translateY(-1px);
}

.compact-form input::placeholder {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.9rem;
}

/* Input with toggle - modern */
.input-with-toggle {
    position: relative;
    width: 100%;
}

.input-with-toggle input {
    padding-right: 3.5rem;
}

.input-with-toggle .toggle-btn {
    position: absolute;
    right: 0.8rem;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 8px;
    font-size: 1rem;
}

.input-with-toggle .toggle-btn:hover {
    background: rgba(0, 212, 255, 0.15);
    border-color: rgba(0, 212, 255, 0.3);
    color: var(--primary);
    transform: translateY(-50%) scale(1.05);
}

/* Form actions - minimal spacing */
.form-actions {
    position: static;
    display: flex;
    justify-content: flex-end;
    margin: 1rem 1.5rem 0 1.5rem; /* Reduced top margin */
    padding: 0;
}

.form-actions .btn-save {
    padding: 0.9rem 1.4rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    min-width: 100px;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    background: linear-gradient(135deg, var(--primary), #0099cc);
    color: white;
    position: relative;
    overflow: hidden;
}

.form-actions .btn-save::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s ease;
}

.form-actions .btn-save:hover::before {
    left: 100%;
}

.form-actions .btn-save:hover {
    background: linear-gradient(135deg, #00b8e6, var(--primary));
    transform: translateY(-2px);
    box-shadow: 
        0 8px 25px rgba(0, 212, 255, 0.4),
        0 0 20px rgba(0, 212, 255, 0.2);
}

.form-actions .btn-save:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.form-actions .btn-save:disabled:hover {
    transform: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.form-actions .btn-save i {
    font-size: 1rem;
}

/* Hide cancel button and close button */
.form-actions .btn-cancel,
.modal-compact .modal-close {
    display: none !important;
}

/* Normal modal body padding */
.modal-compact .modal-body {
    padding-bottom: 1.5rem;
}

.compact-form .form-row:last-of-type {
    margin-bottom: 0;
}

/* Responsive adjustments */
@media (max-width: 480px) {
    .modal-content.modal-compact {
        width: 98%;
        margin: 1vh auto;
        max-height: 98vh;
        border-radius: 12px;
    }
    
    .modal-compact .modal-header {
        padding: 0.8rem 1.2rem 0.4rem 1.2rem !important;
    }
    
    .modal-compact .modal-title {
        font-size: 1.4rem;
        padding-right: 0; /* Remove padding since no close button */
        text-align: center;
    }
    
    .modal-compact .modal-body {
        max-height: calc(98vh - 120px);
        padding-bottom: 1.5rem;
    }
    
    .compact-form {
        min-height: 380px;
        padding-top: 0; /* Remove top padding on mobile too */
    }
    
    .compact-form .form-row {
        padding: 0 1.2rem;
        margin-bottom: 0.6rem !important;
    }
    
    .compact-form .form-row:last-of-type {
        margin-bottom: 1rem;
    }
    
    .compact-form label {
        font-size: 0.8rem;
        gap: 0.5rem;
        margin-bottom: 0.2rem !important;
    }
    
    .compact-form label i {
        font-size: 1.1rem;
        width: 22px;
        height: 22px;
    }
    
    .compact-form input {
        padding: 0.9rem 1rem;
        font-size: 0.9rem;
        border-radius: 10px;
    }
    
    .compact-form input::placeholder {
        font-size: 0.85rem;
    }
    
    .input-with-toggle input {
        padding-right: 3.2rem;
    }
    
    .input-with-toggle .toggle-btn {
        width: 28px;
        height: 28px;
        right: 0.6rem;
        font-size: 0.9rem;
        border-radius: 6px;
    }
    
    .form-actions {
        margin: 0.8rem 1.2rem 0 1.2rem;
    }
    
    .form-actions .btn-save {
        padding: 0.8rem 1.1rem;
        font-size: 0.85rem;
        border-radius: 10px;
        min-width: 85px;
    }
    
    .form-actions .btn-save i {
        font-size: 0.9rem;
    }
}

/* ==================== MODAL ==================== */

.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
}

.modal.active {
    display: flex;
}

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(5px);
}

.modal-content {
    position: relative;
    background: rgba(23, 26, 34, 0.98);
    border: 1px solid rgba(0, 212, 255, 0.3);
    border-radius: 12px;
    width: 95%;
    max-width: 450px;
    margin: 2vh auto;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    animation: modalSlideIn 0.3s ease;
    overflow: visible;
    max-height: 95vh;
}

.modal-content.modal-small {
    max-width: 400px;
}

@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem 1rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.modal-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--light);
    margin: 0;
}

.modal-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--gray-light);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-size: 1.2rem;
}

.modal-close:hover {
    background: rgba(239, 68, 68, 0.1);
    border-color: #ef4444;
    color: #ef4444;
}

.modal-body {
    padding: 1.25rem 1.5rem;
    height: auto;
    max-height: calc(90vh - 100px);
    overflow-y: visible;
}

/* Smart overflow for modal body - only show scroll when truly needed */
@media (max-height: 600px) {
    .modal-body {
        overflow-y: auto;
    }
}

.modal-actions {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.5rem 1.25rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.modal-actions .btn {
    flex: 1;
}

/* Form Groups */
.form-group {
    margin-bottom: 1rem;
}
}

.form-group label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gray-light);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.375rem;
}

.form-group input {
    width: 100%;
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    color: var(--light);
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem;
    transition: all var(--transition-normal);
}

.form-group input:focus {
    outline: none;
    border-color: var(--primary);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
}

.input-with-icon {
    position: relative;
}

.input-with-icon input {
    padding-right: 3rem;
}

.input-with-icon .toggle-password {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--gray);
    cursor: pointer;
    transition: all var(--transition-fast);
    border-radius: var(--radius-sm);
}

.input-with-icon .toggle-password:hover {
    background: rgba(0, 212, 255, 0.1);
    color: var(--primary);
}

/* Delete Modal */
.delete-account-name {
    font-weight: 700;
    color: var(--primary);
    text-align: center;
    font-size: 1.1rem;
    margin-top: 1rem;
}

.btn-danger {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    color: white;
}

.btn-danger:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);
}

/* ==================== RESPONSIVE ==================== */

@media (max-width: 768px) {
    .accounts-table-container {
        overflow-x: auto;
    }
    
    .accounts-table {
        min-width: 600px;
    }
    
    .modal-content {
        width: 98%;
        max-width: none;
        margin: 1vh auto;
        max-height: 98vh;
    }
    
    .modal-body {
        padding: 1rem;
        height: auto;
        max-height: calc(95vh - 80px);
        overflow-y: visible;
    }
    
    /* Smart overflow for mobile - show scroll when needed */
    @media (max-height: 500px) {
        .modal-body {
            overflow-y: auto;
        }
    }
    
    .modal-header {
        padding: 1rem;
    }
    
    .modal-actions {
        flex-direction: column;
        padding: 1rem;
    }
    
    .modal-actions .btn {
        width: 100%;
    }
}


/* ==================== INFO BOXES ==================== */

.settings-info-box {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    border: 1px solid;
}

.info-box-primary {
    background: rgba(0, 212, 255, 0.05);
    border-color: rgba(0, 212, 255, 0.3);
}

.info-box-warning {
    background: rgba(255, 193, 7, 0.05);
    border-color: rgba(255, 193, 7, 0.3);
}

.info-box-success {
    background: rgba(0, 208, 132, 0.05);
    border-color: rgba(0, 208, 132, 0.3);
}

.info-box-icon {
    font-size: 2rem;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
}

.info-box-primary .info-box-icon {
    color: var(--primary);
    background: rgba(0, 212, 255, 0.1);
}

.info-box-warning .info-box-icon {
    color: #ffc107;
    background: rgba(255, 193, 7, 0.1);
}

.info-box-success .info-box-icon {
    color: #00d084;
    background: rgba(0, 208, 132, 0.1);
}

.info-box-content {
    flex: 1;
}

.info-box-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--light);
    margin: 0 0 0.5rem 0;
}

.info-box-text {
    font-size: 0.9rem;
    color: var(--gray-light);
    line-height: 1.6;
    margin: 0 0 0.75rem 0;
}

.info-box-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all var(--transition-fast);
}

.info-box-link:hover {
    color: var(--light);
    gap: 0.75rem;
}

.info-box-link i {
    font-size: 1.1rem;
}

/* Permissions List */
.permissions-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0 0;
}

.permissions-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.5rem 0;
    font-size: 0.9rem;
    color: var(--gray-light);
}

.permissions-list li i {
    font-size: 1.2rem;
    color: #ffc107;
    flex-shrink: 0;
    margin-top: 0.1rem;
}

.permissions-list li strong {
    color: var(--light);
    font-weight: 600;
}

/* Security Features List */
.security-features-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0 0;
}

.security-features-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    font-size: 0.9rem;
    color: var(--gray-light);
}

.security-features-list li i {
    font-size: 1.2rem;
    color: #00d084;
    flex-shrink: 0;
}

/* Permissions Endpoints */
.permissions-endpoints {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.endpoint-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 193, 7, 0.2);
    border-radius: var(--radius-sm);
    padding: 1rem;
}

.endpoint-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    color: var(--light);
    font-size: 0.95rem;
}

.endpoint-header i {
    color: #ffc107;
    font-size: 1.2rem;
}

.endpoint-code {
    display: inline-block;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 4px;
    padding: 0.4rem 0.75rem;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    color: #ffc107;
    margin-bottom: 0.5rem;
}

.endpoint-desc {
    font-size: 0.85rem;
    color: var(--gray-light);
    line-height: 1.5;
    margin: 0;
}

.permissions-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.75rem;
    background: rgba(0, 212, 255, 0.05);
    border: 1px solid rgba(0, 212, 255, 0.2);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    color: var(--gray-light);
    line-height: 1.5;
}

.permissions-note i {
    color: var(--primary);
    font-size: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
}

/* Responsive Info Boxes */
@media (max-width: 768px) {
    .settings-info-box {
        flex-direction: column;
        text-align: center;
    }
    
    .info-box-icon {
        margin: 0 auto;
    }
    
    .permissions-list li,
    .security-features-list li {
        flex-direction: column;
        text-align: center;
        gap: 0.5rem;
    }
    
    .endpoint-header {
        flex-direction: column;
        text-align: center;
        gap: 0.25rem;
    }
    
    .endpoint-code {
        font-size: 0.75rem;
        padding: 0.3rem 0.5rem;
    }
    
    .permissions-note {
        flex-direction: column;
        text-align: center;
    }
}


/* ==================== FORM HINT WARNING ==================== */

.form-hint-warning {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffc107 !important;
    font-weight: 600;
    padding: 0.5rem;
    background: rgba(255, 193, 7, 0.1);
    border-radius: var(--radius-sm);
    margin-top: 0.5rem;
}

.form-hint-warning i {
    font-size: 1.1rem;
    flex-shrink: 0;
}

/* ==================== TASKS PAGE ==================== */

.accounts-container {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: var(--spacing-lg);
}

.loading-state, .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl);
    text-align: center;
}

.loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(0, 212, 255, 0.1);
    border-top: 3px solid var(--primary-color);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: var(--spacing-md);
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.empty-state .empty-icon {
    font-size: 4rem;
    margin-bottom: var(--spacing-md);
    opacity: 0.5;
}

.empty-state h3 {
    color: var(--text-primary);
    margin-bottom: var(--spacing-sm);
}

.empty-state p {
    color: var(--text-secondary);
    margin-bottom: var(--spacing-lg);
}

.accounts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--spacing-md);
}

.account-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: var(--spacing-md);
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
}

.account-card:hover {
    border-color: rgba(0, 212, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
}

.account-card.selected {
    border-color: var(--primary-color);
    background: rgba(0, 212, 255, 0.1);
}

.account-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-sm);
}

.account-username {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 1.1rem;
}

.account-status {
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
}

.account-status.checked {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
}

.account-status.unchecked {
    background: rgba(156, 163, 175, 0.2);
    color: #9ca3af;
}

.account-info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
}

.account-info-item {
    display: flex;
    flex-direction: column;
}

.account-info-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 2px;
}

.account-info-value {
    font-size: 0.9rem;
    color: var(--text-primary);
    font-weight: 500;
}

.account-actions {
    display: flex;
    gap: var(--spacing-sm);
}

.account-check-btn {
    flex: 1;
    padding: 8px 12px;
    background: var(--gradient-primary);
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
}

.account-check-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 212, 255, 0.3);
}

.account-check-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

.account-inventory-btn {
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.account-inventory-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
}

/* ==================== BULK CHECK MODAL ==================== */

.modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.modal-title {
    color: var(--text-primary);
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
}

.modal-close {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    transition: all 0.3s ease;
}

.modal-close:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
}

.modal-body {
    padding: var(--spacing-lg);
    height: auto;
    max-height: calc(90vh - 100px);
    overflow-y: visible;
}

.modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-sm);
    padding: var(--spacing-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.bulk-check-step h4 {
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    font-size: 1.1rem;
}

.account-selection {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: var(--spacing-md);
}

.selection-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.checkbox-container {
    display: flex;
    align-items: center;
    cursor: pointer;
    position: relative;
}

.checkbox-container input[type="checkbox"] {
    opacity: 0;
    position: absolute;
    cursor: pointer;
}

.checkmark {
    height: 18px;
    width: 18px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    margin-right: var(--spacing-sm);
    transition: all 0.3s ease;
}

.checkbox-container:hover .checkmark {
    border-color: var(--primary-color);
}

.checkbox-container input:checked ~ .checkmark {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.checkbox-container input:checked ~ .checkmark:after {
    content: "";
    position: absolute;
    display: block;
    left: 5px;
    top: 1px;
    width: 4px;
    height: 8px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}

.checkbox-label {
    color: var(--text-primary);
    font-weight: 500;
}

.selected-count {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.accounts-list {
    max-height: 300px;
    overflow-y: auto;
}

.bulk-account-item {
    display: flex;
    align-items: center;
    padding: var(--spacing-sm);
    border-radius: 6px;
    transition: all 0.3s ease;
    cursor: pointer;
}

.bulk-account-item:hover {
    background: rgba(255, 255, 255, 0.03);
}

.bulk-account-info {
    margin-left: var(--spacing-sm);
    flex: 1;
}

.bulk-account-username {
    color: var(--text-primary);
    font-weight: 500;
    margin-bottom: 2px;
}

.bulk-account-details {
    color: var(--text-secondary);
    font-size: 0.8rem;
}

.progress-container {
    margin-bottom: var(--spacing-md);
}

.progress-bar {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: var(--spacing-sm);
}

.progress-fill {
    height: 100%;
    background: var(--gradient-primary);
    width: 0%;
    transition: width 0.3s ease;
}

.progress-text {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.current-check {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: var(--spacing-md);
    color: var(--text-primary);
    font-weight: 500;
}

.results-summary {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: var(--spacing-md);
}

.results-container {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: var(--spacing-lg);
}

.result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
}

.result-item:last-child {
    border-bottom: none;
}

.result-item:hover {
    background: rgba(255, 255, 255, 0.02);
}

.result-info {
    flex: 1;
}

.result-username {
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 4px;
}

.result-details {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.result-status {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
}

.result-status.success {
    background: rgba(34, 197, 94, 0.2);
    color: #22c55e;
}

.result-status.error {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}

/* ==================== RESPONSIVE ==================== */

@media (max-width: 768px) {
    .accounts-grid {
        grid-template-columns: 1fr;
    }
    
    .modal-content {
        width: 95%;
        margin: 2% auto;
    }
    
    .account-info {
        grid-template-columns: 1fr;
    }
}