# Server Configuration
PORT=5050
NODE_ENV=development

# Database
DATABASE_PATH=./data/database.sqlite

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session Configuration
SESSION_EXPIRY_DAYS=30

# CORS
CORS_ORIGIN=http://localhost:5050

# Rate Limiting Configuration
# Anonymous users (not logged in)
RATE_LIMIT_ANONYMOUS_WINDOW_MS=900000
RATE_LIMIT_ANONYMOUS_MAX=100

# Authenticated users (logged in)
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_MAX=1000

# Auth endpoints (login/register)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# Critical operations (password change, account delete)
RATE_LIMIT_CRITICAL_WINDOW_MS=900000
RATE_LIMIT_CRITICAL_MAX=10

# Write operations (POST/PUT/DELETE)
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=30

# FarmLabs API (optional)
FARMLABS_API_KEY=

# Webshare API (optional)
WEBSHARE_API_KEY=

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Sentry Error Tracking (optional - only for production)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
APP_VERSION=1.0.0
